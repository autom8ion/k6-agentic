# Copy to .env and adjust as needed. k6 does not auto-load .env files -- source
# it into your shell first, e.g.:
#   export $(grep -v '^#' .env | xargs)
# or pass values directly with -e KEY=value on the k6 run command line.

# Which SLO profile to use (see src/config/env.ts): demo | staging | production
TEST_ENV=demo

# --- REST (QuickPizza demo target: https://quickpizza.grafana.com) ---
REST_BASE_URL=https://quickpizza.grafana.com
# Shared public demo token, safe to use against QuickPizza's read/rating endpoints.
REST_DEMO_TOKEN=token abcdef0123456789
# QuickPizza's seeded demo account, used by the smoke test's login-chain example.
REST_DEFAULT_USERNAME=default
REST_DEFAULT_PASSWORD=12345678

# --- GraphQL (Countries demo API: https://countries.trevorblades.com/graphql) ---
GRAPHQL_URL=https://countries.trevorblades.com/graphql

# --- k6 built-in web dashboard (local ad-hoc HTML summary) ---
# K6_WEB_DASHBOARD=true
# K6_WEB_DASHBOARD_EXPORT=reports/summary.html

# --- Prometheus remote-write output (requires `npm run dashboard:up` running) ---
# K6_PROMETHEUS_RW_SERVER_URL=http://localhost:9090/api/v1/write
